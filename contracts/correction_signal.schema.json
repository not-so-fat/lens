{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "correction_signal.schema.json",
  "type": "object",
  "required": [
    "ts",
    "event",
    "id",
    "lens",
    "deliverable",
    "check",
    "kind",
    "note",
    "status"
  ],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "event": { "const": "correction_signal" },
    "id": { "type": "string", "pattern": "^cs_[a-z0-9]+$" },
    "lens": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "deliverable": { "type": "string", "minLength": 1 },
    "check": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "kind": { "enum": ["miss", "noise"] },
    "note": { "type": "string", "minLength": 1 },
    "lens_run_ts": { "type": "string", "format": "date-time" },
    "status": { "enum": ["open", "actioned", "discarded"] },
    "linked_patch_id": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
